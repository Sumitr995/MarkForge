PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/markforge"
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=sk-...
PYTHON_PATH=
PYTHON_SCRIPT=
ASSETS_DIR=
BACKEND_URL=http://localhost:5000
# comma-free single origin allowed to call the API (CORS). Empty = localhost + prod defaults.
FRONTEND_ORIGIN=
# upload cap in MB (server-enforced, default 20)
MAX_FILE_SIZE_MB=20
# keep extracted images for 24h (ms) — frontend needs them after upload
ASSET_RETENTION_MS=86400000

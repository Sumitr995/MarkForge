# API origin — leave empty for same-origin /api (Vite proxy in dev, same domain in prod)
# Examples:
# VITE_API_URL=https://api.markforge.app
# VITE_API_URL=http://localhost:5000   (local dev)
VITE_API_URL=

# Public URLs shown in UI/docs/curl examples
VITE_API_PUBLIC_URL=https://api.markforge.app
VITE_SITE_URL=https://markforge.app
